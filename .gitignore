# Microsoft Office lock/owner files, created while a document is open
~$*

# Local prompt-interception telemetry. The kernel writes to the user's home
# directory by default; this covers the case where GOV_TELEMETRY_DIR is pointed
# at the working tree for debugging. Prompt-derived data must never be committed.
.copilot-gov/
.tmp-telemetry/

node_modules/

# Local dogfood hook used for in-repo testing. The canonical hook files live
# in hooks/ (root) and are synced downstream by sync-copilot-instructions.sh
# as .github/hooks/. This local copy is machine-specific and must not be
# committed.
.github/hooks/

# Claude Code local settings — machine-specific paths, never commit.
.claude/
